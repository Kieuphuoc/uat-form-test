# Same-origin via Vite proxy → Form.Api :5600 (cookie keycloak gửi kèm khi domain=localhost)
VITE_API_URL=http://localhost:5600/api
# Chat.Api (service riêng, gọi trực tiếp bằng Bearer JWT)
VITE_CHAT_API_URL=http://localhost:5400
# Approval.Api (designer /admin/approval) — :5410 tránh trùng Chat; auth = JWT giống Form/Chat
VITE_APPROVAL_API_URL=http://localhost:5410
# File.Api local (launchSettings :5200). :5100 là Auth.Api — không phải file/avatar.
VITE_FILES_BASE_URL=https://apifile.arito.net
# Notification.Api (preference CHAT / danh sách thiết bị Firebase)
VITE_NOTI_API_URL=https://apinoti.arito.net
# Files web (preview iframe /view/{fileId})
VITE_FILES_WEB_URL=https://files.arito.net
# File-web portal (notification admin redirect)
VITE_FILE_WEB_URL=https://files.arito.net
# Portal Knowledge — embed BlockNote editor FAQ
VITE_KNOWLEDGE_WEB_URL=http://localhost:3020
# Cạnh dài tối đa (px) khi resize ảnh chat ở client trước lúc upload
VITE_CHAT_IMAGE_MAX_SIZE=1024
